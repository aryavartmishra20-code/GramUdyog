# GramUdyog Environment Configuration
# Copy this file to .env and fill in your Supabase credentials

# Supabase Backend Configuration
# Obtain from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key-here

# Optional: LLM Generative AI Key (Gemini or OpenAI for dynamic Advisor responses)
# If not provided, GramUdyog uses the built-in Rural Enterprise Advisor Engine.
VITE_GEMINI_API_KEY=
VITE_OPENAI_API_KEY=
